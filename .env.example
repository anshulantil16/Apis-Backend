# ── Security ────────────────────────────────────────────────
# Generate a new key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-this-to-a-long-random-secret-key

DEBUG=False

# Comma-separated. Include server IP and any domain you use.
ALLOWED_HOSTS=103.205.66.97,localhost,127.0.0.1

# ── Database ─────────────────────────────────────────────────
# After installing PostgreSQL on the Windows server:
# DATABASE_URL format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:your_pg_password@localhost:5432/apis_db

# ── Server ───────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_THREADS=8

# ── CORS ─────────────────────────────────────────────────────
# Set to False once you lock down origins
CORS_ALLOW_ALL=False
# Your frontend URLs (comma-separated, no trailing slash)
CORS_EXTRA_ORIGINS=https://apis-frontend-mu.vercel.app,http://103.205.66.97

# ── Email (optional) ─────────────────────────────────────────
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
