# ── Security ────────────────────────────────────────────────
# Generate a new key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-this-to-a-long-random-secret-key

DEBUG=False

# Comma-separated. Include server IP and any domain you use.
ALLOWED_HOSTS=103.205.66.97,localhost,127.0.0.1

# ── Database ─────────────────────────────────────────────────
# Leave everything below unset for local dev — falls back to SQLite (db.sqlite3).
# QA/Production use MySQL via DB_NAME/DB_USER/... below (see STRUCTURE.md).
# DATABASE_URL, if set, takes priority over DB_NAME and can point at any
# dj-database-url-supported backend, e.g. mysql://USER:PASSWORD@HOST:3306/DBNAME
# DATABASE_URL=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# ── Server ───────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_THREADS=8

# ── CORS ─────────────────────────────────────────────────────
# Set to False once you lock down origins
CORS_ALLOW_ALL=False
# Your frontend URLs (comma-separated, no trailing slash)
CORS_EXTRA_ORIGINS=https://apis-frontend-mu.vercel.app,http://103.205.66.97

# ── Email (optional) ─────────────────────────────────────────
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
